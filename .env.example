# Copy to .env and adjust as needed:  cp .env.example .env

# --- api ---
API_REPLICAS=2
ADMIN_TOKEN=dev-admin-token
DB_POOL_SIZE=5
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
CACHE_TTL_SECONDS=5

# --- postgres ---
POSTGRES_USER=orders
POSTGRES_PASSWORD=orders
POSTGRES_DB=orders

# --- agent ---
# Optional: with a key the analyze/recommend nodes call Claude (claude-opus-5,
# adaptive thinking). Without it the agent uses a deterministic rule table and
# the demo still completes every scenario.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional Slack incoming-webhook for incident + escalation alerts.
SLACK_WEBHOOK_URL=
AGENT_MAX_REPLICAS=6
AGENT_POLL_INTERVAL_SECONDS=10
AGENT_VERIFY_COOLDOWN_SECONDS=25

# --- host ports ---
TRAEFIK_HTTP_PORT=80
TRAEFIK_DASHBOARD_PORT=8080
AGENT_UI_PORT=8000
LOCUST_WEB_PORT=8089
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
